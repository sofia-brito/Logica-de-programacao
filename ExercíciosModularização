package FixaçãoModularização;

import java.util.Scanner;

public class Fixação1 {

	public static void main(String[] args) {
		
		int num1, num2, operacao; 
		
		Scanner calculo = new Scanner(System.in);
		
		System.out.println("Digite o primeiro número: ");
		num1 = calculo.nextInt();
		
		System.out.println("Digite o segundo número: ");
		num2 = calculo.nextInt();
		
		System.out.println("Deseja somar ou subtarir? (Digite 1 para somar e 2 para subtrair)");
		operacao = calculo.nextInt();
		
		if(operacao == 1) {
		 soma(num1, num2);
	
		}
		if(operacao == 2) {
			subtração(num1, num2);
		}

	}
	 public static void soma(int num1, int num2) {
		 int soma;
		 
		soma = num1 + num2;
		System.out.println("A soma é: "+ soma);
	 }
    public static void subtração(int num1, int num2) {
    	int subtraçao;
    	
    	subtraçao = num1 - num2;
    	System.out.println("A subtração é: "+ subtraçao);
    }
}
