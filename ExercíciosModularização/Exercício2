package FixaçãoModularização;

import java.util.Scanner;

public class Fixação2 {

	public static void main(String[] args) {
		
        int num1, num2, operacao, resul; 
		
		Scanner calculo = new Scanner(System.in);
		
		System.out.println("Digite o primeiro número: ");
		num1 = calculo.nextInt();
		
		System.out.println("Digite o segundo número: ");
		num2 = calculo.nextInt();
		
		System.out.println("Deseja somar ou subtarir? (Digite 1 para somar e 2 para subtrair)");
		operacao = calculo.nextInt();
		
		if(operacao == 1) {
		 resul = soma(num1, num2);
		 System.out.println("A soma é: " + resul);
	
		}
		if(operacao == 2) {
		  resul = subtração(num1, num2);
		  System.out.println("A subtração é: " + resul);
		}

	}
	 public static int soma(int num1, int num2) {
		 int resultado;
		 
		 resultado = num1 + num2;
		 return resultado;
		
	 }
    public static int subtração(int num1, int num2) {
    	int resultado;
    	
    	resultado = num1 - num2;
    	return resultado;
    	
    }

	}
